module View.Output exposing (outputPanel)

import Security exposing (blockedModuleNames)
import Sky.Core.List as List
import Sky.Core.Prelude exposing (..)
import Sky.Core.String as String
import State exposing (..)
import Std.Ui as Ui exposing (Element)
import Std.Ui.Background as Background
import Std.Ui.Border as Border
import Std.Ui.Font as Font
import View.Common exposing (..)


-- ── Output panel ─────────────────────────────────────────────────────────────
outputPanel : Model -> Element Msg
outputPanel model =
    let
        t = model.themeIndex
    in
        Ui.column
            [ Ui.width (Ui.fillPortion 2)
            , Ui.height Ui.fill
            , Background.color (bg0 t)
            ]
            [ outputToolbar model, activeTabContent model ]


-- ── Tab toolbar ───────────────────────────────────────────────────────────────
outputToolbar : Model -> Element Msg
outputToolbar model =
    let
        t = model.themeIndex
    in
        Ui.row
            [ Ui.width Ui.fill
            , Ui.paddingXY 4 0
            , Ui.spacing 0
            , Ui.centerY
            , Background.color (bg1 t)
            , Border.color (borderColour t)
            , Border.widthEach { top = 0, right = 0, bottom = 1, left = 0 }
            ]
            [ tabButton t model OutputTab "Output"
            , tabButton t model QuickRefTab "Quick Ref"
            , tabButton t model AboutTab "About Sky"
            , Ui.el [Ui.width Ui.fill] (Ui.text "")
            , Ui.el
                  [ Ui.paddingXY 12 0, Ui.centerY ]
                  (statusBadge t model.runStatus)
            ]


tabButton : Int -> Model -> Tab -> String -> Element Msg
tabButton t model tab label =
    let
        isActive = model.activeTab == tab
    in
        Ui.el
            [ Ui.onClick (TabChanged tab)
            , Ui.pointer
            , Ui.paddingXY 14 10
            , Font.size 17
            , Font.family Font.monospace
            , Font.color
                  (if isActive then
                      accent t

                  else
                      textMuted t)
            , Border.color
                  (if isActive then
                      accent t

                  else
                      transparent)
            , Border.widthEach { top = 0, right = 0, bottom = 2, left = 0 }
            ]
            (Ui.text label)


-- ── Active tab content ────────────────────────────────────────────────────────
activeTabContent : Model -> Element Msg
activeTabContent model =
    let
        t = model.themeIndex
    in
        case model.activeTab of

            OutputTab ->
                outputContent model

            QuickRefTab ->
                quickRefContent t

            AboutTab ->
                aboutContent t


outputContent : Model -> Element Msg
outputContent model =
    let
        t = model.themeIndex
    in
        case model.runStatus of

            Idle ->
                idlePlaceholder t

            Running ->
                runningView t

            Succeeded ->
                if String.isEmpty (String.trim model.runOutput) then
                    Ui.el
                        [ Ui.padding 16
                        , Font.family Font.monospace
                        , Font.size 24
                        , Font.color (textMuted t)
                        ]
                        (Ui.text
                            "(programme ran successfully — no stdout output)")

                else
                    scrollableLines (textPrimary t) model.runOutput

            Failed ->
                scrollableLines (colourError t) model.runOutput


idlePlaceholder : Int -> Element Msg
idlePlaceholder t =
    Ui.el
        [ Ui.width Ui.fill, Ui.height Ui.fill ]
        (Ui.column
            [ Ui.centerX, Ui.centerY, Ui.spacing 10 ]
            [ Ui.el
                  [ Font.size 54, Font.color (textMuted t), Ui.centerX ]
                  (Ui.text "☁")
            , Ui.el
                  [ Font.size 18
                  , Font.family Font.monospace
                  , Font.color (textMuted t)
                  , Ui.centerX
                  ]
                  (Ui.text "Press ▶ Run to execute your Sky code")
            ])


runningView : Int -> Element Msg
runningView t =
    Ui.el
        [ Ui.width Ui.fill, Ui.height Ui.fill ]
        (Ui.column
            [ Ui.centerX, Ui.centerY, Ui.spacing 8, Ui.padding 20 ]
            [ Ui.el
                  [ Font.size 17
                  , Font.family Font.monospace
                  , Font.color (colourWarning t)
                  , Ui.centerX
                  ]
                  (Ui.text "sky build src/Main.sky && ./sky-out/app")
            , Ui.el
                  [ Font.size 17
                  , Font.family Font.monospace
                  , Font.color (textMuted t)
                  , Ui.centerX
                  ]
                  (Ui.text "Building and running… (5 s timeout applied)")
            ])


scrollableLines : Ui.Color -> String -> Element Msg
scrollableLines lineColour output =
    Ui.el
        [ Ui.width Ui.fill, Ui.height Ui.fill, Ui.scrollbars ]
        (Ui.column
            [ Ui.width Ui.fill, Ui.padding 16, Ui.spacing 1 ]
            (List.map (outputLine lineColour) (String.lines output)))


outputLine : Ui.Color -> String -> Element Msg
outputLine lineColour line =
    Ui.el
        [ Font.family Font.monospace, Font.size 18, Font.color lineColour ]
        (Ui.text
            (if String.isEmpty line then
                " "

            else
                line))


aboutContent : Int -> Element Msg
aboutContent t =
    Ui.el
        [ Ui.height Ui.fill, Ui.scrollbars ]
        (Ui.column
            [ Ui.padding 20, Ui.spacing 14 ]
            [ infoCard
                  t
                  "☁  Sky Language"
                  [ "Pure functional, ML-family language compiling to Go."
                  , "Hindley-Milner types · pattern matching · Elm-compatible syntax."
                  , ""
                  , "Build:  sky build src/Main.sky"
                  , "Run:    ./sky-out/app"
                  , "Format: sky fmt src/Main.sky"
                  ]
            , infoCard
                  t
                  "🔁  Sky.Live + TEA"
                  [ "Server-driven UI using Model / Update / View / Subscriptions."
                  , "Full HTML on load, VNode patches on events via SSE."
                  , "No JavaScript — the server handles all logic."
                  ]
            , infoCard
                  t
                  "🎨  Std.Ui"
                  [ "Typed no-CSS layout DSL (elm-ui heritage)."
                  , "Use row / column / el with Background, Border, Font."
                  , "No stylesheets, no class names, no raw CSS."
                  ]
            , blockedLibsCard t
            , infoCard
                  t
                  "✅  Allowed in playground"
                  [ "String · List · Dict · Set · Maybe · Result"
                  , "Math · Regex · Char · Crypto (hashing) · Encoding"
                  , "Json.Encode · Json.Decode · Uuid · Task · Time"
                  , "Random · Log.println"
                  ]
            ])


infoCard : Int -> String -> List String -> Element Msg
infoCard t cardTitle bodyLines =
    Ui.column
        [ Ui.width Ui.fill
        , Ui.spacing 6
        , Ui.padding 14
        , Background.color (bg1 t)
        , Border.color (borderColour t)
        , Border.width 1
        , Border.rounded 8
        ]
        (Ui.el
            [ Font.bold, Font.color (accent t), Font.size 18 ]
            (Ui.text cardTitle)
            :: List.map
                   (\line ->
                       Ui.el
                           [ Font.size 17
                           , Font.family Font.monospace
                           , Font.color
                                 (if String.isEmpty line then
                                     textMuted t

                                 else
                                     textSecondary t)
                           ]
                           (Ui.text
                               (if String.isEmpty line then
                                   " "

                               else
                                   line)))
                   bodyLines)


blockedLibsCard : Int -> Element Msg
blockedLibsCard t =
    let
        nameList = String.join " · " blockedModuleNames
    in
        Ui.column
            [ Ui.spacing 8
            , Ui.padding 14
            , Background.color (warningCardBg t)
            , Border.color (warningCardBorder t)
            , Border.width 1
            , Border.rounded 8
            ]
            [ Ui.el
                  [ Font.bold, Font.color (colourWarning t), Font.size 18 ]
                  (Ui.text "⚠  Blocked in playground")
            , Ui.wrappedRow
                  [ Font.size 17
                  , Font.family Font.monospace
                  , Font.color (textMuted t)
                  ]
                  [Ui.text nameList]
            , Ui.el
                  [ Font.size 17, Font.color (textSecondary t) ]
                  (Ui.text
                      "These modules access the file system, network, processes, or databases.")
            , Ui.el
                  [ Font.size 17, Font.color (textSecondary t) ]
                  (Ui.text
                      "Dangerous import lines are stripped server-side before any build attempt.")
            ]


-- ── Quick-reference panel ─────────────────────────────────────────────────────
quickRefContent : Int -> Element Msg
quickRefContent t =
    Ui.el
        [ Ui.width Ui.fill, Ui.height Ui.fill, Ui.scrollbars ]
        (Ui.column
            [ Ui.width Ui.fill, Ui.padding 20, Ui.spacing 14 ]
            [ refGroup
                  t
                  "Types"
                  [ "String · Int · Float · Bool"
                  , "Maybe · Result · Task Error a"
                  , "List · Dict · Set"
                  ]
            , refGroup
                  t
                  "Effects"
                  [ "Task Error a", "Cmd msg · Sub msg", "Task.andThen" ]
            , refGroup
                  t
                  "Operators"
                  [ "|>  <|  pipeline"
                  , "::  cons   ++  append"
                  , "==  /=  <  <=  >  >="
                  ]
            , refGroup
                  t
                  "Syntax"
                  [ "let … in"
                  , "case … of"
                  , "\\x -> expr"
                  , "{ r | field = v }"
                  ]
            ])


refGroup : Int -> String -> List String -> Element Msg
refGroup t groupTitle lines =
    Ui.column
        [ Ui.width Ui.fill
        , Ui.spacing 6
        , Ui.padding 14
        , Background.color (bg1 t)
        , Border.color (borderColour t)
        , Border.width 1
        , Border.rounded 8
        ]
        (Ui.el
            [ Font.bold, Font.color (accent t), Font.size 18 ]
            (Ui.text groupTitle)
            :: List.map
                   (\line ->
                       Ui.el
                           [ Font.size 17
                           , Font.family Font.monospace
                           , Font.color (textMuted t)
                           , Ui.paddingXY 6 0
                           , Border.color
                                 (if isDark t then
                                     Ui.rgba 88 166 255 0.1

                                 else
                                     Ui.rgba 37 99 235 0.1)
                           , Border.widthEach
                                 { top = 0, right = 0, bottom = 0, left = 1 }
                           ]
                           (Ui.text line))
                   lines)
