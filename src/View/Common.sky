transparent : Ui.Color
transparent =
    Ui.rgba 0 0 0 0.0


closeOverlay : Msg -> Element Msg
closeOverlay closeMsg =
    Ui.el [ Ui.width Ui.fill, Ui.height Ui.fill, Ui.onClick closeMsg ] Ui.none


-- ── Action button (primary — fill) ───────────────────────────────────────────
actionButton : ThemeRecord -> Msg -> Bool -> String -> Element Msg
actionButton t onPress isDisabled label =
    Ui.button
        [ Ui.paddingXY 18 8
        , Ui.width (Ui.px 36)
        , Border.rounded 6
        , if isDisabled then
              Background.color t.bg3

          else
              Background.color t.accent
        , if isDisabled then
              Font.color t.textMuted

          else
              Font.color Ui.white
        , Font.size 13
        , Font.bold
        ]
        { onPress = if isDisabled then
              Nothing

          else
              Just onPress
        , label = Ui.text label
        }


-- ── Secondary button (ghost — dim border) ────────────────────────────────────
secondaryButton : ThemeRecord -> Msg -> String -> Element Msg
secondaryButton t onPress label =
    Ui.button
        [ Ui.paddingXY 14 7
        , Border.rounded 6
        , Background.color t.bg2
        , Border.color t.borderColour
        , Border.width 1
        , Font.color t.textSecondary
        , Font.size 12
        , Font.family Font.monospace
        ]
        { onPress = Just onPress, label = Ui.text label }


-- ── Status badge ──────────────────────────────────────────────────────────────
statusBadge : ThemeRecord -> RunStatus -> Element Msg
statusBadge t status =
    let
        ( badgeColour, badgeLabel ) =
            case status of

                Idle ->
                    ( t.textMuted, "idle" )

                Running ->
                    ( t.colourWarning, "running…" )

                Succeeded ->
                    ( t.colourSuccess, "success" )

                Failed ->
                    ( t.colourError, "failed" )
    in
        Ui.el
            [ Font.size 11
            , Font.family Font.monospace
            , Font.color badgeColour
            , Ui.paddingXY 8 4
            , Background.color t.bg2
            , Border.rounded 20
            , Border.color t.statusBadgeBorder
            , Border.width 1
            ]
            (Ui.text badgeLabel)


-- ── Section label ─────────────────────────────────────────────────────────────
sectionLabel : ThemeRecord -> String -> Element Msg
sectionLabel t heading =
    Ui.el
        [ Font.size 10
        , Font.color t.textMuted
        , Font.family Font.monospace
        , Ui.paddingXY 14 8
        ]
        (Ui.text (String.toUpper heading))
