type alias ThemeRecord =
    { bg0 : Ui.Color
    , bg1 : Ui.Color
    , bg2 : Ui.Color
    , bg3 : Ui.Color
    , accent : Ui.Color
    , accentDim : Ui.Color
    , accentBorder : Ui.Color
    , textPrimary : Ui.Color
    , textSecondary : Ui.Color
    , textMuted : Ui.Color
    , textLineNumber : Ui.Color
    , colourSuccess : Ui.Color
    , colourWarning : Ui.Color
    , colourError : Ui.Color
    , warningBg : Ui.Color
    , warningBorder : Ui.Color
    , warningCardBg : Ui.Color
    , warningCardBorder : Ui.Color
    , borderColour : Ui.Color
    , statusBadgeBorder : Ui.Color
    , isDark : Bool
    }
-- ── Transparent color ─────────────────────────────────────────────────────────


