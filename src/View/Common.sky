import Sky.Core.Prelude exposing (..)
import Sky.Core.String as String
import Std.Ui as Ui exposing (Element)
import Std.Ui.Background as Background
import Std.Ui.Border as Border
import Std.Ui.Font as Font
import State exposing (..)


-- ── Theme names (index matches palette order) ────────────────────────────────
themeNames : List String
themeNames =
    [ "Midnight"
    , "GitHub Dark"
    , "One Dark"
    , "Dracula"
    , "Nord"
    , "Solarized Light"
    , "Warm Paper"
    , "GitHub Light"
    , "Material Light"
    , "Polar Ice"
    ]


-- ── Helper ───────────────────────────────────────────────────────────────────
isDark : Int -> Bool
isDark idx =
    idx <= 4


-- ── Colour palette (Int = themeIndex, 0 = darkest, 9 = lightest) ─────────────
-- 0 Midnight · 1 GitHub Dark · 2 One Dark · 3 Dracula · 4 Nord
-- 5 Solarized Light · 6 Warm Paper · 7 GitHub Light · 8 Material Light · 9 Polar Ice
bg0 : Int -> Ui.Color
bg0 t =
    case t of

        0 ->
            Ui.rgb 0 0 0

        1 ->
            Ui.rgb 13 17 23

        2 ->
            Ui.rgb 40 44 52

        3 ->
            Ui.rgb 40 42 54

        4 ->
            Ui.rgb 46 52 64

        5 ->
            Ui.rgb 253 246 227

        6 ->
            Ui.rgb 253 250 244

        7 ->
            Ui.rgb 255 255 255

        8 ->
            Ui.rgb 250 250 250

        _ ->
            Ui.rgb 248 251 255


