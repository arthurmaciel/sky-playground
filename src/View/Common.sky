accentDim : Int -> Ui.Color
accentDim t =
    if isDark t then
        case t of

            3 ->
                Ui.rgba 189 147 249 0.15

            4 ->
                Ui.rgba 136 192 208 0.15

            _ ->
                Ui.rgba 88 166 255 0.15

    else
        case t of

            6 ->
                Ui.rgba 180 100 40 0.12

            _ ->
                Ui.rgba 37 99 235 0.1


