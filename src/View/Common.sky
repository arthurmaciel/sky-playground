module View.Common exposing
    ( ThemeRecord
    , getTheme
    , themeName
    , allThemes
    , transparent
    , closeOverlay
    -- Reusable elements
    , actionButton
    , secondaryButton
    , statusBadge
    , sectionLabel
    )

import Sky.Core.Prelude exposing (..)
import Sky.Core.String as String
import Std.Ui as Ui exposing (Element)
import Std.Ui.Background as Background
import Std.Ui.Border as Border
import Std.Ui.Font as Font
import State exposing (..)

-- ── Theme data ────────────────────────────────────────────────────────────────
type alias ThemeRecord =
    { bg0 : Ui.Color
    , bg1 : Ui.Color
    , bg2 : Ui.Color
    , bg3 : Ui.Color
    , accent : Ui.Color
    , accentDim : Ui.Color
    , accentBorder : Ui.Color
    , textPrimary : Ui.Color
    , textSecondary : Ui.Color
    , textMuted : Ui.Color
    , textLineNumber : Ui.Color
    , colourSuccess : Ui.Color
    , colourError : Ui.Color
    , colourWarning : Ui.Color
    , warningBg : Ui.Color
    , warningBorder : Ui.Color
    , warningCardBg : Ui.Color
    , warningCardBorder : Ui.Color
    , borderColour : Ui.Color
    , statusBadgeBorder : Ui.Color
    , isDark : Bool
    }


allThemes : List Theme
allThemes =
    [ Midnight
    , GitHubDark
    , OneDark
    , Dracula
    , Nord
    , SolarizedLight
    , WarmPaper
    , GitHubLight
    , MaterialLight
    , PolarIce
    ]


themeName : Theme -> String
themeName theme =
    case theme of

        Midnight ->
            "Midnight"

        GitHubDark ->
            "GitHub Dark"

        OneDark ->
            "One Dark"

        Dracula ->
            "Dracula"

        Nord ->
            "Nord"

        SolarizedLight ->
            "Solarized Light"

        WarmPaper ->
            "Warm Paper"

        GitHubLight ->
            "GitHub Light"

        MaterialLight ->
            "Material Light"

        PolarIce ->
            "Polar Ice"


