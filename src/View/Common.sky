-- ── Action button (primary — fill) ───────────────────────────────────────────
actionButton : Int -> Msg -> Bool -> String -> Element Msg
actionButton t onPress isDisabled label =
    Ui.button
        [ Ui.paddingXY 18 8
        , Border.rounded 6
        , if isDisabled then
              Background.color (bg3 t)

          else
              Background.color (accent t)
        , if isDisabled then
              Font.color (textMuted t)

          else
              Font.color Ui.white
        , Font.size 18
        , Font.bold
        ]
        { onPress = if isDisabled then
              Nothing

          else
              Just onPress
        , label = Ui.text label
        }


-- ── Secondary button (ghost — dim border) ────────────────────────────────────
secondaryButton : Int -> Msg -> String -> Element Msg
secondaryButton t onPress label =
    Ui.button
        [ Ui.paddingXY 14 7
        , Border.rounded 6
        , Background.color (bg2 t)
        , Border.color (borderColour t)
        , Border.width 1
        , Font.color (textSecondary t)
        , Font.size 17
        , Font.family Font.monospace
        ]
        { onPress = Just onPress, label = Ui.text label }


-- ── Status badge ──────────────────────────────────────────────────────────────
statusBadge : Int -> RunStatus -> Element Msg
statusBadge t status =
    let
        ( badgeColour, badgeLabel ) =
            case status of

                Idle ->
                    ( textMuted t, "idle" )

                Running ->
                    ( colourWarning t, "running…" )

                Succeeded ->
                    ( colourSuccess t, "success" )

                Failed ->
                    ( colourError t, "failed" )
        borderBase =
            if isDark t then
                Ui.rgba 88 166 255 0.15

            else
                case t of

                    6 ->
                        Ui.rgba 180 100 40 8.0e-2

                    _ ->
                        Ui.rgba 37 99 235 0.1
    in
        Ui.el
            [ Font.size 15
            , Font.family Font.monospace
            , Font.color badgeColour
            , Ui.paddingXY 8 4
            , Background.color (bg2 t)
            , Border.rounded 20
            , Border.color borderBase
            , Border.width 1
            ]
            (Ui.text badgeLabel)


-- ── Section label ─────────────────────────────────────────────────────────────
sectionLabel : Int -> String -> Element Msg
sectionLabel t heading =
    Ui.el
        [ Font.size 14
        , Font.color (textMuted t)
        , Font.family Font.monospace
        , Ui.paddingXY 14 8
        ]
        (Ui.text (String.toUpper heading))
