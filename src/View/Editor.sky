module View.Editor exposing (editorPanel)

import Examples exposing (examples)
import Sky.Core.Prelude exposing (..)
import Sky.Core.String as String
import State exposing (..)
import Std.Ui as Ui exposing (Element)
import Std.Ui.Background as Background
import Std.Ui.Border as Border
import Std.Ui.Font as Font
import Std.Ui.Input as Input
import View.Common exposing (..)
import Std.Html as Html
import Std.Html.Attributes as Attr


exampleMirror : Model -> Element msg
exampleMirror model =
    let
        id = "example-mirror-wrapper"
        name = id ++ "-" ++ String.fromInt model.activeExample
    in
        Ui.el [ Ui.htmlAttribute "id" id, Ui.htmlAttribute "name" name ]
            <| Ui.html
                   (Html.node
                       "textarea"
                       [ Attr.name "example-mirror"
                       , Attr.id "example-mirror"
                       , Attr.attribute "hidden" ""
                       ]
                       [Html.text model.currentCode])


editorPanel : Model -> Element Msg
editorPanel model =
    let
        t = getTheme model.theme
    in
        Ui.column
            [ Ui.width (Ui.fillPortion 3)
            , Ui.height Ui.fill
            , Background.color t.bg0
            , Border.color t.borderColour
            , Border.widthEach { top = 0, right = 1, bottom = 0, left = 0 }
            ]
            [ exampleMirror model
            , toolbar model
            , securityBanner model
            , codeInput model
            ]


toolbar : Model -> Element Msg
toolbar model =
    let
        t = getTheme model.theme
    in
        Ui.row
            [ Ui.width Ui.fill
            , Ui.paddingXY 14 6
            , Ui.spacing 8
            , Ui.centerY
            , Background.color t.bg1
            , Border.color t.borderColour
            , Border.widthEach { top = 0, right = 0, bottom = 1, left = 0 }
            ]
            [ exampleSelector model
            , Ui.el [Ui.width Ui.fill] (Ui.text "")
            , fmtStatusHint model
            ]


exampleSelector : Model -> Element Msg
exampleSelector model =
    let
        t = getTheme model.theme
        triggerLabel =
            if model.activeExample < 0 then
                "Select an example…"

            else
                case List.head (List.drop model.activeExample examples) of

                    Just ex ->
                        ex.name

                    Nothing ->
                        "Select an example…"
        triggerColour =
            if model.activeExample < 0 then
                t.textMuted

            else
                t.textSecondary
        trigger =
            Ui.el
                [ Ui.paddingXY 10 5
                , Background.color t.bg2
                , Border.rounded 5
                , Border.color t.borderColour
                , Border.width 1
                , Ui.pointer
                , Ui.onClick ToggleDropdown
                , Ui.width (Ui.px 260)
                ]
                (Ui.el
                    [ Font.family Font.monospace
                    , Font.size 12
                    , Font.color triggerColour
                    ]
                    (Ui.text triggerLabel))
        dropdownItem ex =
            Ui.el
                [ Ui.paddingXY 12 8
                , Ui.width Ui.fill
                , Ui.pointer
                , Ui.onClick (LoadExample ex.index)
                , Font.family Font.monospace
                , Font.size 12
                , Font.color t.textSecondary
                ]
                (Ui.text ex.name)
        dropdown =
            Ui.column
                [ Ui.width (Ui.px 260)
                , Background.color t.bg2
                , Ui.htmlAttribute "style" "z-index: 5"
                , Border.color t.borderColour
                , Border.width 1
                , Border.rounded 5
                ]
                (List.map dropdownItem examples)
    in
        Ui.el
            (if model.exampleDropdownOpen then
                [ Ui.below dropdown, Ui.inFront (closeOverlay CloseDropdown) ]

            else
                [])
            trigger


fmtLabel : Model -> String
fmtLabel model =
    case model.formatStatus of

        FmtRunning ->
            "Formatting…"

        _ ->
            "Format"


runLabel : Model -> String
runLabel model =
    case model.runStatus of

        Running ->
            "Running…"

        _ ->
            "▶  Run"


fmtStatusHint : Model -> Element Msg
fmtStatusHint model =
    let
        t = getTheme model.theme
    in
        case model.formatStatus of

            FmtFailed ->
                Ui.el
                    [ Font.size 11
                    , Font.family Font.monospace
                    , Font.color t.colourError
                    ]
                    (Ui.text "fmt failed")

            _ ->
                Ui.text ""
-- ── Security warning banner ───────────────────────────────────────────────────
-- Shown when the user's code contains an import of a blocked module.
-- The banner is informational — the server already strips the dangerous
-- imports before building, so the user can still run the sanitised code.


securityBanner : Model -> Element Msg
securityBanner model =
    let
        t = getTheme model.theme
    in
        if String.isEmpty model.securityWarning then
            Ui.text ""

        else
            Ui.row
                [ Ui.width Ui.fill
                , Ui.paddingXY 14 10
                , Ui.spacing 12
                , Background.color t.warningBg
                , Border.color t.warningBorder
                , Border.widthEach { top = 0, right = 0, bottom = 1, left = 3 }
                ]
                [ Ui.column
                      [ Ui.width Ui.fill, Ui.spacing 3 ]
                      [ Ui.el
                            [ Font.size 12
                            , Font.bold
                            , Font.color t.colourWarning
                            ]
                            (Ui.text "⚠  Restricted module detected")
                      , Ui.el
                            [ Font.size 12
                            , Font.color t.textSecondary
                            , Font.family Font.monospace
                            ]
                            (Ui.text
                                "Dangerous import lines were stripped before building. See the About tab for details.")
                      ]
                , Ui.button
                      [ Font.size 12
                      , Font.color t.textMuted
                      , Background.color t.bg2
                      , Border.rounded 4
                      , Ui.paddingXY 10 5
                      , Ui.centerY
                      ]
                      { onPress = Just DismissWarning, label = Ui.text "✕" }
                ]


codeInput : Model -> Element Msg
codeInput model =
    let
        t = getTheme model.theme
    in
        Ui.column
            []
            [ Ui.el
                  [ Ui.htmlAttribute "id" "editor"
                  , Ui.width Ui.fill
                  , Ui.height Ui.fill
                  ]
                  Ui.none
            , Ui.form
                  [Ui.onSubmit RunClicked]
                  [Ui.html
                      (Html.node
                          "textarea"
                          [ Attr.name "code"
                          , Attr.id "ace-mirror"
                          , Attr.attribute "hidden" ""
                          ]
                          [])]
            , Ui.el [Ui.paddingXY 6 6] <| actionButton t NoOp False "Run ▶"
            , Ui.form
                  [Ui.onSubmit FormatClicked]
                  [ Ui.html
                        (Html.node
                            "textarea"
                            [ Attr.name "fmtcode"
                            , Attr.id "fmt-code-mirror"
                            , Attr.attribute "hidden" ""
                            ]
                            [])
                  , Ui.el [Ui.paddingXY 6 6]
                        <| secondaryButton t NoOp (fmtLabel model)
                  ]
            ]
