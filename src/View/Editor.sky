lineNumCol : ThemeRecord -> String -> Element Msg
lineNumCol t code =
    let
        codeLines = String.lines code
    in
        Ui.column
            [ Ui.paddingXY 1 16
            , Ui.alignRight
            , Font.color t.textLineNumber
            , Ui.height Ui.fill
            ]
            (List.indexedMap
                (\i l ->
                    (Ui.el [Ui.alignRight] (Ui.text (String.fromInt (i + 1)))))
                codeLines)
