module View.Editor exposing (editorPanel)

import Examples exposing (examples)
import Sky.Core.Prelude exposing (..)
import Sky.Core.String as String
import State exposing (..)
import Std.Ui as Ui exposing (Element)
import Std.Ui.Background as Background
import Std.Ui.Border as Border
import Std.Ui.Font as Font
import Std.Ui.Input as Input
import View.Common exposing (..)


-- ── Editor panel ─────────────────────────────────────────────────────────────
editorPanel : Model -> Element Msg
editorPanel model =
    let
        t = model.themeIndex
    in
        Ui.column
            [ Ui.width (Ui.fillPortion 3)
            , Ui.height Ui.fill
            , Background.color (bg0 t)
            , Border.color (borderColour t)
            , Border.widthEach { top = 0, right = 1, bottom = 0, left = 0 }
            ]
            [ toolbar model, securityBanner model, codeInput model ]


-- ── Toolbar ───────────────────────────────────────────────────────────────────
toolbar : Model -> Element Msg
toolbar model =
    let
        t = model.themeIndex
    in
        Ui.row
            [ Ui.width Ui.fill
            , Ui.paddingXY 14 8
            , Ui.spacing 8
            , Ui.centerY
            , Background.color (bg1 t)
            , Border.color (borderColour t)
            , Border.widthEach { top = 0, right = 0, bottom = 1, left = 0 }
            ]
            [ exampleSelector model
            , Ui.el [Ui.width Ui.fill] (Ui.text "")
            , fmtStatusHint model
            , secondaryButton t FormatClicked (fmtLabel model)
            , actionButton
                  t
                  RunClicked
                  (model.runStatus == Running)
                  (runLabel model)
            ]


-- ── Example selector (pure Ui dropdown) ──────────────────────────────────────
-- Trigger element + Ui.below dropdown panel. No Std.Html, no inline CSS.
exampleSelector : Model -> Element Msg
exampleSelector model =
    let
        t = model.themeIndex
        triggerLabel =
            if model.activeExample < 0 then
                "Select an example…"

            else
                case List.head (List.drop model.activeExample examples) of

                    Just ex ->
                        ex.name

                    Nothing ->
                        "Select an example…"
        triggerColour =
            if model.activeExample < 0 then
                textMuted t

            else
                textSecondary t
        trigger =
            Ui.el
                [ Ui.paddingXY 10 5
                , Background.color (bg2 t)
                , Border.rounded 5
                , Border.color (borderColour t)
                , Border.width 1
                , Ui.pointer
                , Ui.onClick ToggleDropdown
                , Ui.width (Ui.px 260)
                ]
                (Ui.el
                    [ Font.family Font.monospace
                    , Font.size 17
                    , Font.color triggerColour
                    ]
                    (Ui.text triggerLabel))
        dropdownItem ex =
            Ui.el
                [ Ui.paddingXY 12 8
                , Ui.width Ui.fill
                , Ui.pointer
                , Ui.onClick (LoadExample ex.index)
                , Font.family Font.monospace
                , Font.size 17
                , Font.color (textSecondary t)
                ]
                (Ui.text ex.name)
        dropdown =
            Ui.column
                [ Ui.width (Ui.px 260)
                , Background.color (bg2 t)
                , Border.color (borderColour t)
                , Border.width 1
                , Border.rounded 5
                ]
                (List.map dropdownItem examples)
    in
        Ui.el
            (if model.exampleDropdownOpen then
                [Ui.below dropdown]

            else
                [])
            trigger


fmtLabel : Model -> String
fmtLabel model =
    case model.formatStatus of

        FmtRunning ->
            "Formatting…"

        FmtSucceeded ->
            "✓ Formatted"

        _ ->
            "sky fmt"


runLabel : Model -> String
runLabel model =
    case model.runStatus of

        Running ->
            "Running…"

        _ ->
            "▶  Run"


fmtStatusHint : Model -> Element Msg
fmtStatusHint model =
    let
        t = model.themeIndex
    in
        case model.formatStatus of

            FmtFailed ->
                Ui.el
                    [ Font.size 15
                    , Font.family Font.monospace
                    , Font.color (colourError t)
                    ]
                    (Ui.text "fmt failed")

            _ ->
                Ui.text ""


-- ── Security warning banner ───────────────────────────────────────────────────
-- Shown when the user's code contains an import of a blocked module.
-- The banner is informational — the server already strips the dangerous
-- imports before building, so the user can still run the sanitised code.
securityBanner : Model -> Element Msg
securityBanner model =
    let
        t = model.themeIndex
    in
        if String.isEmpty model.securityWarning then
            Ui.text ""

        else
            Ui.row
                [ Ui.width Ui.fill
                , Ui.paddingXY 14 10
                , Ui.spacing 12
                , Background.color (warningBg t)
                , Border.color (warningBorder t)
                , Border.widthEach { top = 0, right = 0, bottom = 1, left = 3 }
                ]
                [ Ui.column
                      [ Ui.width Ui.fill, Ui.spacing 3 ]
                      [ Ui.el
                            [ Font.size 17
                            , Font.bold
                            , Font.color (colourWarning t)
                            ]
                            (Ui.text "⚠  Restricted module detected")
                      , Ui.el
                            [ Font.size 17
                            , Font.color (textSecondary t)
                            , Font.family Font.monospace
                            ]
                            (Ui.text
                                "Dangerous import lines were stripped before building. See the About tab for details.")
                      ]
                , Ui.button
                      [ Font.size 17
                      , Font.color (textMuted t)
                      , Background.color (bg2 t)
                      , Border.rounded 4
                      , Ui.paddingXY 10 5
                      , Ui.centerY
                      ]
                      { onPress = Just DismissWarning, label = Ui.text "✕" }
                ]


-- ── Code textarea ─────────────────────────────────────────────────────────────
-- Uses Std.Ui.Input.multiline which renders a real <textarea>.
-- spellcheck = False prevents browser spell-check from underlining
-- Sky keywords and identifiers.
codeInput : Model -> Element Msg
codeInput model =
    let
        t = model.themeIndex
    in
        Ui.row
            [ Ui.width Ui.fill
            , Ui.height Ui.fill
            , Ui.padding 2
            , Background.color (bg0 t)
            ]
            [ lineNumCol t model.code
            , Ui.el
                  [ Ui.width Ui.fill
                  , Ui.height Ui.fill
                  , Font.family Font.monospace
                  , Font.size 16
                  , Font.color (textPrimary t)
                  , Border.width 0
                  , Ui.padding 16
                  ]
                  <| Input.multiline
                         [ Background.color (bg0 t)
                         , Ui.width Ui.fill
                         , Ui.height Ui.fill
                         ]
                         { onChange = CodeChanged
                         , text = model.code
                         , placeholder = Just
                               (Input.placeholder
                                   [ Font.color (textMuted t)
                                   , Font.family Font.monospace
                                   , Font.size 16
                                   ]
                                   (Ui.text
                                       "-- Write your Sky code here, or pick an example above…"))
                         , label = Input.labelHidden "Sky source code editor"
                         , spellcheck = False
                         }
            ]


lineNumCol : Int -> String -> Element Msg
lineNumCol t code =
    let
        codeLines = String.lines code
    in
        Ui.column
            [ Ui.paddingXY 1 16
            , Ui.alignRight
            , Font.color (textLineNumber t)
            , Ui.height Ui.fill
            ]
            (List.indexedMap
                (\i l ->
                    (Ui.el [Ui.alignRight] (Ui.text (String.fromInt (i + 1)))))
                codeLines)
