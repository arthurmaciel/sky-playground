module Update exposing (update)

import Examples exposing (examples)
import Runner
import Security
import Sky.Core.Error as Error
import Sky.Core.List as List
import Sky.Core.Prelude exposing (..)
import Sky.Core.Task as Task
import State exposing (..)


update : Msg -> Model -> ( Model, Cmd Msg )
update msg model =
    case msg of

        CodeChanged newCode ->
            ( { model | currentCode = newCode, securityWarning = "" }
            , Cmd.none
            )

        FormatClicked payload ->
            let
            -- Always notify the user if dangerous imports were found, but
            -- we still proceed (Runner.runCode calls Security.sanitise
            -- internally, stripping them before the build).
                warning =
                    if Security.isDangerous payload.code then
                        Security.warningMessage

                    else
                        ""
            in
                ( { model | formatStatus = FmtRunning
                  , securityWarning = warning
                  }
                , Cmd.perform (Runner.formatCode payload.code) GotFormatResult
                )

        GotFormatResult result ->
            case result of

                Ok formatted ->
                    ( { model | currentCode = formatted
                      , formatStatus = FmtSucceeded
                      }
                    , Cmd.none
                    )

                Err e ->
                    ( { model | formatStatus = FmtFailed
                      , securityWarning = "Format error: " ++ Error.toString e
                      }
                    , Cmd.none
                    )

        RunClicked payload ->
            let
                warning =
                    if Security.isDangerous payload.code then
                        Security.warningMessage

                    else
                        ""
            in
                ( { model | runStatus = Running
                  , runOutput = ""
                  , securityWarning = warning
                  , activeTab = OutputTab
                  }
                , Cmd.perform (Runner.runCode payload.code) GotRunResult
                )

        GotRunResult result ->
            case result of

                Ok output ->
                    ( { model | runOutput = output, runStatus = Succeeded }
                    , Cmd.none
                    )

                Err e ->
                    ( { model | runOutput = "Error: " ++ Error.toString e
                      , runStatus = Failed
                      }
                    , Cmd.none
                    )

        NoOp ->
            ( model, Cmd.none )

        LoadExample i ->
            let
                maybeEx = List.head (List.drop i examples)
            in
                case maybeEx of

                    Just ex ->
                        ( { model | currentCode = ex.code
                          , activeExample = i
                          , exampleDropdownOpen = False
                          , runOutput = ""
                          , runStatus = Idle
                          , formatStatus = FmtIdle
                          , securityWarning = ""
                          }
                        , Cmd.none
                        )

                    Nothing ->
                        ( model, Cmd.none )

        TabChanged tab ->
            ( { model | activeTab = tab }, Cmd.none )

        ToggleDropdown ->
            ( { model | exampleDropdownOpen = not model.exampleDropdownOpen }
            , Cmd.none
            )

        CloseDropdown ->
            ( { model | exampleDropdownOpen = False }, Cmd.none )

        SelectTheme theme ->
            ( { model | theme = theme, themeDropdownOpen = False }, Cmd.none )

        ToggleThemeDropdown ->
            ( { model | themeDropdownOpen = not model.themeDropdownOpen }
            , Cmd.none
            )

        CloseThemeDropdown ->
            ( { model | themeDropdownOpen = False }, Cmd.none )

        DismissWarning ->
            ( { model | securityWarning = "" }, Cmd.none )
