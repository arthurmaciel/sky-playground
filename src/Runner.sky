module Runner exposing (formatCode, runCode)

import Security
import Sky.Core.Crypto as Crypto
import Sky.Core.Error as Error
import Sky.Core.File as File
import Sky.Core.Prelude exposing (..)
import Sky.Core.Process as Process
import Sky.Core.String as String
import Sky.Core.Task as Task


sandboxToml : String
sandboxToml =
    """[project]
name = "playground-sandbox"
version = "0.1.0"
main = "src/Main.sky"
"""


shellIn : String -> String -> Task Error String
shellIn dir cmd =
    Process.run "sh" [ "-c", "( cd " ++ dir ++ " && " ++ cmd ++ " )" ]


withTempDir : String -> (String -> Task Error a) -> Task Error a
withTempDir prefix action =
    let
        runWithTempDir token =
            let
                dir = "tmp/" ++ prefix ++ "-" ++ token
                src = dir ++ "/src"
                cleanup =
                    let
                        _ = Process.run "rm" [ "-rf", dir ]
                    in
                        Task.succeed ()
            in
                File.mkdirAll src |> Task.andThen (\_ -> action dir)
                    |> Task.andThen
                           (\result ->
                               let
                                   _ = cleanup
                               in
                                   Task.succeed result)
                    |> Task.onError
                           (\err ->
                               let
                                   _ = cleanup
                               in
                                   Task.fail err)
    in
        Crypto.randomToken 4 |> Task.andThen runWithTempDir


formatCode : String -> Task Error String
formatCode code =
    let
        safe = Security.sanitise code
    in
        withTempDir
            "sky-fmt"
            (\dir ->
                let
                    skyFile = dir ++ "/src/Main.sky"
                in
                    File.writeFile (dir ++ "/sky.toml") sandboxToml
                        |> Task.andThen (\_ -> File.writeFile skyFile safe)
                        |> Task.andThen
                               (\_ -> shellIn dir "sky fmt src/Main.sky")
                        |> Task.andThen (\_ -> File.readFile skyFile))


runCode : String -> Task Error String
runCode code =
    let
        safe = Security.sanitise code
        buildAndRun dir =
            let
                writeToml = File.writeFile (dir ++ "/sky.toml") sandboxToml
                writeMain = File.writeFile (dir ++ "/src/Main.sky") safe
                build _ = shellIn dir "sky build src/Main.sky"
                run buildOut =
                    shellIn dir "./sky-out/app"
                        |> Task.andThen
                               (\runOut ->
                                   Task.succeed (formatOutput buildOut runOut))
                formatOutput buildOutput runOutput =
                    "── Build ─────────────\n" ++ (String.trim buildOutput)
                        ++ "\n"
                        ++ "── Run ──────────────\n"
                        ++ (String.trim runOutput)
                        ++ "\n"
            in
                Task.sequence [ writeToml, writeMain ] |> Task.andThen build
                    |> Task.andThen run
    in
        withTempDir "sky-run" buildAndRun
