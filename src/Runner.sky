module Runner exposing (formatCode, runCode)

import Security
import Sky.Core.Crypto as Crypto
import Sky.Core.Error as Error
import Sky.Core.File as File
import Sky.Core.Prelude exposing (..)
import Sky.Core.Process as Process
import Sky.Core.String as String
import Sky.Core.Task as Task


sandboxToml : String
sandboxToml =
    """[project]
name = "playground-sandbox"
version = "0.1.0"
main = "src/Main.sky"
"""


shellIn : String -> String -> Task Error String
shellIn dir cmd =
    Process.run "sh" [ "-c", "( cd " ++ dir ++ " && " ++ cmd ++ " ) 2>&1;" ]


withTempDir : String -> (String -> Task Error a) -> Task Error a
withTempDir prefix action =
    Crypto.randomToken 4
        |> Task.andThen
               (\token ->
                   let
                       dir = "tmp/" ++ prefix ++ "-" ++ token
                       cleanup =
                           let
                               _ = Process.run "rm" [ "-rf", dir ]
                           in
                               Task.succeed ()
                   in
                       File.mkdirAll (dir ++ "/src")
                           |> Task.andThen (\_ -> action dir)
                           |> Task.andThen
                                  (\result ->
                                      let
                                          _ = cleanup
                                      in
                                          Task.succeed result)
                           |> Task.onError
                                  (\err ->
                                      let
                                          _ = cleanup
                                      in
                                          Task.fail err))


formatCode : String -> Task Error String
formatCode code =
    let
        safe = Security.sanitise code
    in
        withTempDir
            "sky-fmt"
            (\dir ->
                let
                    skyFile = dir ++ "/src/Main.sky"
                in
                    File.writeFile (dir ++ "/sky.toml") sandboxToml
                        |> Task.andThen (\_ -> File.writeFile skyFile safe)
                        |> Task.andThen
                               (\_ -> shellIn dir "sky fmt src/Main.sky")
                        |> Task.andThen (\_ -> File.readFile skyFile))


runCode : String -> Task Error String
runCode code =
    let
        safe = Security.sanitise code
    in
        withTempDir
            "sky-run"
            (\dir ->
                let
                    formatOutput buildOutput runOutput =
                        let
                            buildSection =
                                "── Build ──────────────────────────────────────\n"
                                    ++ (String.trim buildOutput)
                                    ++ "\n"
                            runSection =
                                "── Run ────────────────────────────────────────\n"
                                    ++ (String.trim runOutput)
                                    ++ "\n"
                        in
                            buildSection ++ runSection
                in
                    File.writeFile (dir ++ "/sky.toml") sandboxToml
                        |> Task.andThen
                               (\_ ->
                                   File.writeFile (dir ++ "/src/Main.sky") safe)
                        |> Task.andThen
                               (\_ -> shellIn dir "sky build src/Main.sky")
                        |> Task.andThen
                               (\buildOut ->
                                   shellIn dir "timeout 5s ./sky-out/app"
                                       |> Task.map
                                              (\runOut ->
                                                  formatOutput buildOut runOut)))
