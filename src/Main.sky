module Main exposing (main)

import Examples exposing (examples)
import Sky.Core.List as List
import Sky.Core.Prelude exposing (..)
import Sky.Core.String as String
import State exposing (..)
import Std.Live as Live
import Std.Ui as Ui exposing (Element)
import Std.Ui.Background as Background
import Std.Ui.Border as Border
import Std.Ui.Font as Font
import Update exposing (update)
import View.Common exposing (..)
import View.Editor exposing (editorPanel)
import View.Output exposing (outputPanel)
import Std.Html as Html
import Std.Html.Attributes as HtmlAttrs


-- ── Init ─────────────────────────────────────────────────────────────────────
init : {  } -> ( Model, Cmd Msg )
init _ =
    let
        firstCode =
            case List.head examples of

                Just ex ->
                    ex.code

                Nothing ->
                    "module Main exposing (main)\n\nimport Sky.Core.Prelude exposing (..)\nimport Std.Log exposing (println)\n\nmain =\n    println \"Hello, Sky! ☁\"\n"
    in
        ( { initialModel | code = firstCode }, Cmd.none )


-- ── Subscriptions ─────────────────────────────────────────────────────────────
subscriptions : Model -> Sub Msg
subscriptions _ =
    Sub.none


-- ── Header ────────────────────────────────────────────────────────────────────
logoMark : ThemeRecord -> Element Msg
logoMark t =
    Ui.el
        [ Ui.width (Ui.px 30)
        , Ui.height (Ui.px 30)
        , Background.color t.accent
        , Border.rounded 6
        ]
        (Ui.el
            [ Ui.centerX, Ui.centerY, Font.size 23, Font.color Ui.white ]
            (Ui.text "☁"))


-- ── Theme selector (pure Ui dropdown) ────────────────────────────────────────
themeSelector : Model -> Element Msg
themeSelector model =
    let
        t = getTheme model.theme
        trigger =
            Ui.el
                [ Ui.paddingXY 10 5
                , Background.color t.bg2
                , Border.rounded 5
                , Border.color t.borderColour
                , Border.width 1
                , Ui.pointer
                , Ui.onClick ToggleThemeDropdown
                ]
                (Ui.el
                    [ Ui.centerY
                    , Font.family Font.monospace
                    , Font.size 15
                    , Font.color t.textSecondary
                    ]
                    (Ui.text (themeName model.theme)))
        dropdownItem theme =
            Ui.el
                [ Ui.paddingXY 12 6
                , Ui.width Ui.fill
                , Ui.pointer
                , Ui.onClick (SelectTheme theme)
                , Font.family Font.monospace
                , Font.size 15
                , Font.color
                      (if theme == model.theme then
                          t.accent

                      else
                          t.textSecondary)
                ]
                (Ui.text (themeName theme))
        dropdown =
            Ui.column
                [ Ui.width (Ui.px 180)
                , Background.color t.bg2
                , Border.color t.borderColour
                , Border.width 1
                , Border.rounded 5
                ]
                (List.map dropdownItem allThemes)
    in
        Ui.el
            (if model.themeDropdownOpen then
                [ Ui.below dropdown
                , Ui.inFront (closeOverlay CloseThemeDropdown)
                ]

            else
                [])
            trigger


header : Model -> Element Msg
header model =
    let
        t = getTheme model.theme
    in
        Ui.row
            [ Ui.width Ui.fill
            , Ui.paddingXY 20 0
            , Ui.centerY
            , Ui.spacing 10
            , Ui.height (Ui.px 52)
            , Background.color t.bg1
            , Border.color t.borderColour
            , Border.widthEach { top = 0, right = 0, bottom = 1, left = 0 }
            ]
            [ logoMark t
            , Ui.el
                  [ Font.size 24
                  , Font.bold
                  , Font.color t.textPrimary
                  , Font.family Font.monospace
                  ]
                  (Ui.text "Sky playground")
            , Ui.el [Ui.width Ui.fill] (Ui.text "")
            , themeSelector model
            , Ui.el
                  [ Border.color t.borderColour
                  , Border.widthEach
                        { top = 0, right = 1, bottom = 0, left = 0 }
                  , Ui.paddingXY 6 0
                  , Ui.height (Ui.px 20)
                  ]
                  (Ui.text "")
            , Ui.link
                  [ Font.size 18
                  , Font.color t.textMuted
                  , Font.family Font.monospace
                  ]
                  { url = "https://github.com/arthurmaciel/sky-playground"
                  , label = Ui.text "GitHub ↗"
                  }
            ]


-- ── View ──────────────────────────────────────────────────────────────────────
view : Model -> Html Msg
view model =
    let
        t = getTheme model.theme
    in
        Html.div
            []
            [ Html.script
                  [HtmlAttrs.src
                      "https://cdn.jsdelivr.net/npm/ace-builds/src-min-noconflict/ace.min.js"]
                  []
            , Html.script
                  [HtmlAttrs.src
                      "https://cdn.jsdelivr.net/npm/ace-builds/src/mode-elm.min.js"]
                  []
            , Html.link
                  [ HtmlAttrs.href
                        "https://cdn.jsdelivr.net/npm/ace-builds/css/ace.min.css"
                  , HtmlAttrs.rel "stylesheet"
                  ]
            , Html.node "script" [HtmlAttrs.src "/static/editor.js"] []
            , Ui.layout
                  [Background.color t.bg0]
                  (Ui.column
                      [ Ui.width Ui.fill, Ui.height Ui.fill ]
                      [ header model
                      , Ui.row
                            [ Ui.width Ui.fill, Ui.height Ui.fill ]
                            [ editorPanel model, outputPanel model ]
                      ])
            ]


-- ── Main ──────────────────────────────────────────────────────────────────────
main =
    Live.app
        { init = init
        , update = update
        , view = view
        , subscriptions = subscriptions
        , routes = [Live.route "/" MainPage]
        , notFound = MainPage
        }
