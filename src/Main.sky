module Main exposing (main)

-- Sky.Live + Std.Ui playground — assembles all view modules and wires the
-- TEA loop. View is split across View/* to avoid HM type-checker heap
-- exhaustion on Std.Ui-heavy modules (CLAUDE.md Limitation #17).
-- import Examples exposing (examples)

import Examples exposing (examples)
import Sky.Core.List as List
import Sky.Core.Prelude exposing (..)
import State exposing (..)
import Std.Live as Live
import Std.Ui as Ui exposing (Element)
import Std.Ui.Background as Background
import Std.Ui.Border as Border
import Std.Ui.Font as Font
import Update exposing (update)
import View.Common exposing (..)
import View.Editor exposing (editorPanel)
import View.Output exposing (outputPanel)
import View.Sidebar exposing (sidebar)



-- ── Init ─────────────────────────────────────────────────────────────────────


init : {} -> ( Model, Cmd Msg )
init _ =
    let
        firstCode =
            case List.head examples of
                Just ex ->
                    ex.code

                Nothing ->
                    "module Main exposing (main)\n\nimport Sky.Core.Prelude exposing (..)\nimport Std.Log exposing (println)\n\nmain =\n    println \"Hello, Sky! ☁\"\n"
    in
    ( { initialModel | code = firstCode }
    , Cmd.none
    )



-- ── Subscriptions ─────────────────────────────────────────────────────────────


subscriptions : Model -> Sub Msg
subscriptions _ =
    Sub.none



-- ── Header ────────────────────────────────────────────────────────────────────


logoMark : Element Msg
logoMark =
    Ui.el
        [ Ui.width (Ui.px 30)
        , Ui.height (Ui.px 30)
        , Background.color accent
        , Border.rounded 6
        ]
        (Ui.el
            [ Ui.centerX
            , Ui.centerY
            , Font.size 15
            , Font.color Ui.white
            ]
            (Ui.text "☁")
        )


header : Element Msg
header =
    Ui.row
        [ Ui.width Ui.fill
        , Ui.paddingXY 20 0
        , Ui.spacing 10
        , Ui.height (Ui.px 52)
        , Background.color bg1
        , Border.color borderColour
        , Border.widthEach { top = 0, right = 0, bottom = 1, left = 0 }
        ]
        [ logoMark
        , Ui.el
            [ Font.size 16
            , Font.bold
            , Font.color textPrimary
            , Font.family Font.monospace
            ]
            (Ui.text "Playground")
        , Ui.el
            [ Font.size 10
            , Font.color accent
            , Background.color accentDim
            , Border.color (Ui.rgba 77 158 255 0.3)
            , Border.width 1
            , Border.rounded 20
            , Ui.paddingXY 8 1
            , Font.family Font.monospace
            ]
            (Ui.text "Elm → Go")
        , Ui.el [ Ui.width Ui.fill ] (Ui.text "")
        , Ui.link
            [ Font.size 12
            , Font.color textMuted
            , Font.family Font.monospace
            ]
            { url = "https://github.com/arthurmaciel/sky"
            , label = Ui.text "GitHub ↗"
            }
        ]



-- ── View ──────────────────────────────────────────────────────────────────────
-- Return type is `any` because Ui.layout produces the Sky.Live HTML payload.
-- The three panels are split across dedicated modules; each returns
-- Element Msg, which Ui.layout assembles into the final document.


view : Model -> any
view model =
    Ui.layout
        [ Background.color bg0 ]
        (Ui.column
            [ Ui.width Ui.fill
            , Ui.height Ui.fill
            ]
            [ header
            , Ui.row
                [ Ui.width Ui.fill
                , Ui.height Ui.fill
                ]
                [ sidebar model
                , editorPanel model
                , outputPanel model
                ]
            ]
        )



-- ── Main ──────────────────────────────────────────────────────────────────────


main =
    Live.app
        { init = init
        , update = update
        , view = view
        , subscriptions = subscriptions
        , routes = [ Live.route "/" MainPage ]
        , notFound = MainPage
        }
