module Main exposing (main)

import Sky.Core.Prelude exposing (..)
import State exposing (..)
import Std.Html as Html
import Std.Html.Attributes as HtmlAttrs
import Std.Live as Live
import Std.Ui as Ui exposing (Element)
import Std.Ui.Background as Background
import Update exposing (update)
import View.Editor exposing (editorPanel)
import View.Output exposing (outputPanel)
import View.Common exposing (..)
import Std.Ui.Border as Border
import Std.Ui.Font as Font


-- ── Init ─────────────────────────────────────────────────────────────────────
init : {  } -> ( Model, Cmd Msg )
init _ =
    ( initialModel, Cmd.none )


subscriptions : Model -> Sub Msg
subscriptions _ =
    Sub.none


view : Model -> Html Msg
view model =
    let
        t = getTheme model.theme
    in
        Html.div
            []
            [ Html.script
                  [HtmlAttrs.src
                      "https://cdn.jsdelivr.net/npm/ace-builds/src-min-noconflict/ace.min.js"]
                  []
            , Html.script
                  [HtmlAttrs.src
                      "https://cdn.jsdelivr.net/npm/ace-builds/src/mode-elm.min.js"]
                  []
            , Html.link
                  [ HtmlAttrs.href
                        "https://cdn.jsdelivr.net/npm/ace-builds/css/ace.min.css"
                  , HtmlAttrs.rel "stylesheet"
                  ]
            -- , Ui.el [Ui.width Ui.fill] (Ui.text "")
            , Html.node "script" [HtmlAttrs.src "/static/editor.js?v0.1"] []
            , Ui.layout
                  [Background.color t.bg0]
                  (Ui.column
                      [ Ui.width Ui.fill, Ui.height Ui.fill ]
                      [ header model
                      , Ui.wrappedRow
                            [ Ui.width Ui.fill, Ui.height Ui.fill ]
                            [ editorPanel model, outputPanel model ]
                      ])
            ]


main =
    Live.app
        { init = init
        , update = update
        , view = view
        , subscriptions = subscriptions
        , routes = [Live.route "/" MainPage]
        , notFound = MainPage
        }


logoMark : ThemeRecord -> Element Msg
logoMark t =
    Ui.el
        [ Ui.width (Ui.px 30)
        , Ui.height (Ui.px 30)
        , Background.color t.accent
        , Border.rounded 6
        ]
        (Ui.el
            [ Ui.centerX, Ui.centerY, Font.size 23, Font.color Ui.white ]
            (Ui.text "☁"))


themeSelector : Model -> Element Msg
themeSelector model =
    let
        t = getTheme model.theme
        trigger =
            Ui.el
                [ Ui.paddingXY 10 5
                , Background.color t.bg2
                , Border.rounded 5
                , Border.color t.borderColour
                , Border.width 1
                , Ui.width (Ui.px 260)
                , Ui.pointer
                , Ui.onClick ToggleThemeDropdown
                ]
                (Ui.el
                    [ Font.family Font.monospace
                    , Font.size 15
                    , Font.color t.textSecondary
                    ]
                    (Ui.text (themeName model.theme)))
        dropdownItem theme =
            Ui.el
                [ Ui.paddingXY 12 6
                , Ui.width Ui.fill
                , Ui.pointer
                , Ui.onClick (SelectTheme theme)
                , Font.family Font.monospace
                , Font.size 15
                , Font.color
                      (if theme == model.theme then
                          t.accent

                      else
                          t.textSecondary)
                ]
                (Ui.text (themeName theme))
        dropdown =
            Ui.column
                [ Ui.width (Ui.px 260)
                , Background.color t.bg2
                , Border.color t.borderColour
                , Ui.htmlAttribute "style" "z-index: 10"
                , Border.width 1
                , Border.rounded 5
                ]
                (List.map dropdownItem allThemes)
        id = "theme-selector-wrapper"
        name = id ++ "-" ++ themeName model.theme
        acePath = aceThemePath model.theme
        attrs =
            [ Ui.htmlAttribute "id" id
            , Ui.htmlAttribute "name" name
            , Ui.htmlAttribute "data-ace-theme" acePath
            ]
    in
        Ui.el
            (if model.themeDropdownOpen then
                [ Ui.below dropdown
                , Ui.inFront (closeOverlay CloseThemeDropdown)
                ]
                    ++ attrs

            else
                attrs)
            trigger


header : Model -> Element Msg
header model =
    let
        t = getTheme model.theme
    in
        Ui.wrappedRow
            [ Ui.width Ui.fill
            , Ui.height Ui.shrink
            , Ui.paddingXY 14 15
            , Ui.centerY
            , Ui.spacing 40
            , Background.color t.bg1
            , Border.color t.borderColour
            , Border.widthEach { top = 0, right = 0, bottom = 1, left = 0 }
            ]
            [ Ui.row
                  []
                  [ logoMark t
                  , Ui.el [Ui.width (Ui.px 12)] (Ui.text "")
                  , Ui.el
                        [ Font.size 24
                        , Font.bold
                        , Font.color t.textPrimary
                        , Font.family Font.monospace
                        , Ui.centerX
                        ]
                        (Ui.text "Sky playground")
                  ]
            , themeSelector model
            , Ui.link
                  [ Font.size 18
                  , Font.color t.textMuted
                  , Font.family Font.monospace
                  , Ui.alignRight
                  ]
                  { url = "https://github.com/arthurmaciel/sky-playground"
                  , label = Ui.text "GitHub ↗"
                  }
            ]


explain =
    [ Border.color Ui.white, Border.width 1 ]
