module State exposing (..)

import Sky.Core.Error as Error
import Sky.Core.Prelude exposing (..)

type RunStatus
    = Idle
    | Running
    | Succeeded
    | Failed

type FormatStatus
    = FmtIdle
    | FmtRunning
    | FmtSucceeded
    | FmtFailed

type alias Model =
    { code : String
    , runOutput : String
    , runStatus : RunStatus
    , formatStatus : FormatStatus
    , activeExample : Int
    , exampleDropdownOpen : Bool
    , themeIndex : Int
    , themeDropdownOpen : Bool
    , securityWarning : String
    , activeTab : Tab
    }

type Tab
    = OutputTab
    | QuickRefTab
    | AboutTab


initialModel : Model
initialModel =
    { code = ""
    , runOutput = ""
    , runStatus = Idle
    , formatStatus = FmtIdle
    , activeExample = -1
    , exampleDropdownOpen = False
    , themeIndex = 6
    , themeDropdownOpen = False
    , securityWarning = ""
    , activeTab = OutputTab
    }

type Page
    = MainPage

type Msg
    = CodeChanged String
    | RunClicked
    | FormatClicked
    | GotRunResult (Result Error String)
    | GotFormatResult (Result Error String)
    | LoadExample Int
    | ToggleDropdown
    | CloseDropdown
    | SelectTheme Int
    | ToggleThemeDropdown
    | CloseThemeDropdown
    | TabChanged Tab
    | DismissWarning
