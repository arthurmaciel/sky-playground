module State exposing (..)

import Sky.Core.Error as Error
import Sky.Core.Prelude exposing (..)

type RunStatus
    = Idle
    | Running
    | Succeeded
    | Failed

type FormatStatus
    = FmtIdle
    | FmtRunning
    | FmtSucceeded
    | FmtFailed

type Theme
    = Midnight
    | GitHubDark
    | OneDark
    | Dracula
    | Nord
    | SolarizedLight
    | WarmPaper
    | GitHubLight
    | MaterialLight
    | PolarIce

type alias Model =
    { currentCode : String
    , runOutput : String
    , runStatus : RunStatus
    , formatStatus : FormatStatus
    , activeExample : Int
    , exampleDropdownOpen : Bool
    , theme : Theme
    , themeDropdownOpen : Bool
    , securityWarning : String
    , activeTab : Tab
    }

type Tab
    = OutputTab
    | QuickRefTab
    | AboutTab


initialModel : Model
initialModel =
    { currentCode = ""
    , runOutput = ""
    , runStatus = Idle
    , formatStatus = FmtIdle
    , activeExample = -1
    , exampleDropdownOpen = False
    , theme = WarmPaper
    , themeDropdownOpen = False
    , securityWarning = ""
    , activeTab = OutputTab
    }


blockedModuleNames : List String
blockedModuleNames =
    [ "File"
    , "Io"
    , "Process"
    , "System"
    , "Db"
    , "Auth"
    , "Http"
    , "Server"
    , "Live"
    , "RateLimit"
    , "Middleware"
    , "Ffi"
    , "Context"
    , "Fmt"
    ]

type Page
    = MainPage

type alias RunPayload =
    { code : String }

type Msg
    = CodeChanged String
    | RunClicked RunPayload
    | FormatClicked
    | GotRunResult (Result Error String)
    | GotFormatResult (Result Error String)
    | LoadExample Int
    | ToggleDropdown
    | CloseDropdown
    | SelectTheme Theme
    | ToggleThemeDropdown
    | CloseThemeDropdown
    | TabChanged Tab
    | DismissWarning
    | NoOp
