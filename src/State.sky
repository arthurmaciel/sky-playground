module State exposing (..)

import Sky.Core.Prelude exposing (..)
import Sky.Core.Error as Error


type RunStatus
    = Idle
    | Running
    | Succeeded
    | Failed


type FormatStatus
    = FmtIdle
    | FmtRunning
    | FmtSucceeded
    | FmtFailed


type alias Model =
    { code : String
    , runOutput : String
    , runStatus : RunStatus
    , formatStatus : FormatStatus
    , activeExample : Int
    , securityWarning : String
    , activeTab : Tab
    }


type Tab
    = OutputTab
    | AboutTab


initialModel : Model
initialModel =
    { code = ""
    , runOutput = ""
    , runStatus = Idle
    , formatStatus = FmtIdle
    , activeExample = 0
    , securityWarning = ""
    , activeTab = OutputTab
    }


-- Using a named ADT instead of () avoids a reflect.Call panic at the Sky.Live
-- route-dispatch boundary. The runtime passes route flags as SkyADT structs;
-- bare () compiles to struct{} inside init but arrives as map[string]interface{}
-- at the call site, causing:
--   reflect: Call using map[string]interface {} as type struct {}
type Page
    = MainPage


type Msg
    = CodeChanged String
    | RunClicked
    | FormatClicked
    | GotRunResult (Result Error String)
    | GotFormatResult (Result Error String)
    | LoadExample Int
    | TabChanged Tab
    | DismissWarning
